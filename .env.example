# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# Required only for the AI evaluation step (app/ai_evaluate.py).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-haiku-4-5) used for scoring.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Required for the Jooble aggregator (aggregators.yaml) — the real,
# no-hardcoded-companies market-wide search. Free key, arrives by email:
# https://jooble.org/api/about
JOOBLE_API_KEY=

# Adzuna and Remotive aggregator support is disabled in this fork (see
# aggregators.yaml for why). No keys needed for either unless you
# re-enable them.
