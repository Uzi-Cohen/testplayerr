# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# Required only for the AI evaluation step (app/ai_evaluate.py).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-haiku-4-5) used for scoring.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Adzuna aggregator support is disabled in this fork (see aggregators.yaml
# for why — no Israel coverage, plus a hardcoded Canada-only endpoint in
# app/aggregator_clients.py). No Adzuna keys needed unless you re-enable it.
