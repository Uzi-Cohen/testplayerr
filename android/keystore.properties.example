# Copy this file to android/keystore.properties and fill in your values.
# keystore.properties is git-ignored — never commit it.

# Path to your keystore file, relative to the android/ directory
storeFile=keystore.jks

# The password you set when creating the keystore
storePassword=YOUR_KEYSTORE_PASSWORD

# The alias you chose when creating the keystore
keyAlias=YOUR_KEY_ALIAS

# The password for the specific key (often same as storePassword)
keyPassword=YOUR_KEY_PASSWORD
